<%- include("./headers/register.ejs") %>

<form class="container col-2 login-register-form" id="register-form" method="POST" action="/register">
    <div class="form-group">
      <label for="user">Username</label>
      <input type="user" class="form-control" id="user_name" name="user_name" placeholder="Enter username">
    </div>
    <div class="form-group">
      <label for="password">Password</label>
      <input type="password" class="form-control" id="password" name="password" placeholder="Enter password">
    </div>
    <% if (locals.darkmode) { %>
        <button type="submit" class="btn btn-secondary">Register</button>
    <% } else { %>
        <button type="submit" class="btn btn-dark">Register</button>
    <% } %>
    <% if (locals.error) { %>
        <div class="warning">
            <p class="alert alert-danger"><%= error %></p>
        </div>
    <% } %>
</form>

<%- include("./footers/loginOrRegister.ejs") %>